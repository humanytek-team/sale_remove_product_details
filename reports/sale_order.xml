<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <template id="sale_report_remove_products" inherit_id="sale.report_saleorder_document">
        <!-- Queremos eliminar o modificar las líneas que no tienen un display_type -->
        <xpath expr="//t[t-if='not line.display_type']" position="replace">
            <!-- Aquí podrías insertar una lógica alternativa, o simplemente eliminar -->
            <t t-if="False"/>
        </xpath>
    </template>

  <template id="account_report_remove_products" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@name='account_invoice_line_accountable']" position="attributes">
      <attribute name="t-if">False</attribute>
    </xpath>
  </template>
</odoo>
